  "text": {
    "ar": {
      "program.lib-guide-upper-lower-4.name": "تضخيم علوي/سفلي · 4 أيام",
      "program.lib-guide-upper-lower-4.origin": "مستوحى من: تقسيم Upper/Lower الكلاسيكي",
      "program.lib-guide-upper-lower-4.provenance": "من الدليل اليومي في مكتبة ثبات. قالب أصلي مبني على مبادئ الحجم والتدرج، وليس نسخة من SBS أو PHAT.",
      "program.lib-guide-upper-lower-4.summary": "أربع حصص للتضخيم: علوي أ، سفلي أ، راحة، علوي ب، سفلي ب. ابدأ بنحو 6–10 مجموعات أسبوعية لكل عضلة، وارفعها تدريجيًا إلى 10–14 إذا تحسن الأداء ولم تتراكم الآلام. لا تضف الحجم والوزن في الأسبوع نفسه، ولا تحوّل يوم الراحة لحصة أرجل إضافية.",
      "session.lib-gu.la": "سفلي أ",
      "session.lib-gu.lb": "سفلي ب",
      "session.lib-gu.ua": "علوي أ",
      "session.lib-gu.ub": "علوي ب",
      "variant.lib-guide-upper-lower-4.four-day": "4 أيام في الأسبوع · 8 أسابيع"
    },
    "en": {
      "program.lib-guide-upper-lower-4.name": "Upper/Lower Hypertrophy · 4 days",
      "program.lib-guide-upper-lower-4.origin": "Inspired by: the classic upper/lower split",
      "program.lib-guide-upper-lower-4.provenance": "From the daily guide in the Thabat library. An original template built on volume and progression, not a copy of SBS or PHAT.",
      "program.lib-guide-upper-lower-4.summary": "Four hypertrophy sessions: Upper A, Lower A, rest, Upper B, Lower B. Start around 6–10 weekly sets per muscle and build towards 10–14 if performance improves and aches don't pile up. Don't add volume and load in the same week, and don't turn a rest day into an extra leg day.",
      "session.lib-gu.la": "Lower A",
      "session.lib-gu.lb": "Lower B",
      "session.lib-gu.ua": "Upper A",
      "session.lib-gu.ub": "Upper B",
      "variant.lib-guide-upper-lower-4.four-day": "4 days a week · 8 weeks"
    }
