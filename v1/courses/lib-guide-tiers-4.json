  "text": {
    "ar": {
      "program.lib-guide-tiers-4.name": "قوة وتضخيم بالطبقات · 4 أيام",
      "program.lib-guide-tiers-4.origin": "مستوحى من: GZCLP",
      "program.lib-guide-tiers-4.provenance": "من الدليل اليومي في مكتبة ثبات. يستخدم فكرة طبقات T1/T2/T3 دون نسخ الجدول الأصلي.",
      "program.lib-guide-tiers-4.summary": "أربع حصص علوي/سفلي، كل حصة تبدأ برفعة ثقيلة (T1) ثم تمرين مساند (T2) ثم تمارين حجم (T3). راحة 3–5 دقائق في T1، ودقيقتان في T2، و60–90 ثانية في T3. عندما تصل لأعلى التكرارات دون تجاوز RPE 8 زد الحمل 2–5%، وإذا فشلت جلستين متتاليتين خفّض 5–10%.",
      "session.lib-gt.l1": "سفلي · شدة",
      "session.lib-gt.l2": "سفلي · حجم",
      "session.lib-gt.u1": "علوي · شدة",
      "session.lib-gt.u2": "علوي · حجم",
      "variant.lib-guide-tiers-4.four-day": "4 أيام في الأسبوع · 8 أسابيع"
    },
    "en": {
      "program.lib-guide-tiers-4.name": "Tiered Strength & Size · 4 days",
      "program.lib-guide-tiers-4.origin": "Inspired by: GZCLP",
      "program.lib-guide-tiers-4.provenance": "From the daily guide in the Thabat library. Uses the T1/T2/T3 tier idea without copying the original plan.",
      "program.lib-guide-tiers-4.summary": "Four upper/lower sessions. Each opens with a heavy lift (T1), then a support lift (T2), then volume work (T3). Rest 3–5 minutes on T1, 2 minutes on T2 and 60–90 seconds on T3. When you hit the top of the range without going past RPE 8, add 2–5%; after two failed sessions in a row, drop 5–10%.",
      "session.lib-gt.l1": "Lower · heavy",
      "session.lib-gt.l2": "Lower · volume",
      "session.lib-gt.u1": "Upper · heavy",
      "session.lib-gt.u2": "Upper · volume",
      "variant.lib-guide-tiers-4.four-day": "4 days a week · 8 weeks"
