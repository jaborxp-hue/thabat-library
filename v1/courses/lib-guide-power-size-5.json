    "ar": {
      "program.lib-guide-power-size-5.name": "قوة وتضخيم · 5 أيام",
      "program.lib-guide-power-size-5.origin": "مستوحى من: PHAT",
      "program.lib-guide-power-size-5.provenance": "من الدليل اليومي في مكتبة ثبات. تقسيم أصلي يحافظ على فكرة يومي قوة وثلاثة أيام تضخيم، دون نسخ الجدول المنشور.",
      "program.lib-guide-power-size-5.summary": "يوما قوة (علوي ثم سفلي)، يوم راحة، ثم ثلاثة أيام تضخيم: ظهر وكتف، ساقان، صدر وذراعان. هذا المسار يحتاج تعافيًا أعلى؛ إذا قل النوم أو انخفض الأداء احذف حصة الصدر والذراعين أولًا. لا تستخدم HIIT في يوم الراحة.",
      "session.lib-gp.bs": "تضخيم الظهر والكتف",
      "session.lib-gp.ca": "تضخيم الصدر والذراعين",
      "session.lib-gp.lh": "تضخيم الساقين",
      "session.lib-gp.ls": "قوة الجزء السفلي",
      "session.lib-gp.us": "قوة الجزء العلوي",
      "variant.lib-guide-power-size-5.five-day": "5 أيام في الأسبوع · 8 أسابيع"
    },
    "en": {
      "program.lib-guide-power-size-5.name": "Power & Size · 5 days",
      "program.lib-guide-power-size-5.origin": "Inspired by: PHAT",
      "program.lib-guide-power-size-5.provenance": "From the daily guide in the Thabat library. An original split that keeps the two-strength, three-hypertrophy idea without copying the published plan.",
      "program.lib-guide-power-size-5.summary": "Two strength days (upper, then lower), a rest day, then three hypertrophy days: back and shoulders, legs, chest and arms. This track needs more recovery; if sleep drops or performance slides, drop the chest-and-arms day first. No HIIT on the rest day.",
      "session.lib-gp.bs": "Back & shoulders size",
      "session.lib-gp.ca": "Chest & arms size",
      "session.lib-gp.lh": "Legs size",
      "session.lib-gp.ls": "Lower strength",
